#!/bin/sh
# mido /init — pindahkan root ke rootfs PERMANEN di partisi cache (ext4, mmcblk0p25).
# Bila gagal, tetap boot dari rootfs RAM (fallback) supaya HP tidak pernah brick.
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /tmp /run 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
export INITRAMFS=1

ROOTDEV=/dev/mmcblk0p25
i=0
while [ $i -lt 25 ]; do [ -b "$ROOTDEV" ] && break; i=$((i+1)); sleep 1; done
echo "mido: root dev $ROOTDEV siap setelah ${i}s" >/dev/kmsg

if [ -b "$ROOTDEV" ]; then
	mkdir -p /newroot 2>/dev/null
	if mount -t ext4 -o rw,noatime "$ROOTDEV" /newroot 2>/dev/null; then
		if [ -x /newroot/sbin/init ] && [ -d /newroot/etc/config ]; then
			echo "mido: switch_root -> $ROOTDEV (rootfs permanen)" >/dev/kmsg
			exec switch_root /newroot /sbin/init
		fi
		echo "mido: rootfs partisi tidak valid -> pakai RAM" >/dev/kmsg
		umount /newroot 2>/dev/null
	else
		echo "mido: gagal mount $ROOTDEV -> pakai RAM" >/dev/kmsg
	fi
fi

echo "mido: FALLBACK rootfs RAM" >/dev/kmsg
exec /sbin/init
